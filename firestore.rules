rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** 서비스 운영자 — Custom Claim `admin: true` (키 없을 때 `.admin` / `.get` 접근은 에뮬레이터에서 오류 날 수 있어 hasAny로 가드) */
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function academyData(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)).data;
    }

    function isAcademyOwner(academyId) {
      return isSignedIn() && academyData(academyId).ownerUid == request.auth.uid;
    }

    /** 선생님 멤버 문서 경로 — 초청 후 문서 ID = Auth uid */
    function academyTeacherMemberPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId)/teachers/$(request.auth.uid);
    }

    function isAcademyTeacherMember(academyId) {
      return isSignedIn() && exists(academyTeacherMemberPath(academyId));
    }

    /** 학원 업무(학생·학부모 등)에 참여 가능한 활성 선생님 */
    function isAcademyTeacherActive(academyId) {
      return isSignedIn()
        && exists(academyTeacherMemberPath(academyId))
        && get(academyTeacherMemberPath(academyId)).data.status == 'active';
    }

    /** 학부모 멤버 문서 — 초청 후 문서 ID = Auth uid (초청 전에는 임시 ID) */
    function academyParentMemberPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId)/parents/$(request.auth.uid);
    }

    function isAcademyParentMember(academyId) {
      return isSignedIn() && exists(academyParentMemberPath(academyId));
    }

    /** 자녀 연결 등 — 활성 학부모만 */
    function isAcademyParentActive(academyId) {
      return isSignedIn()
        && exists(academyParentMemberPath(academyId))
        && get(academyParentMemberPath(academyId)).data.status == 'active';
    }

    /**
     * 학원 포털 Custom Token — claim `role` / `academyId` (Cloud Functions 발급).
     * 공용 로그인 폐지 전까지 모든 세부 권한을 가진 것으로 취급(`hasAnyPermission`).
     */
    function isAcademyPortalSession(academyId) {
      return isSignedIn()
        && request.auth.token.keys().hasAll(['role', 'academyId'])
        && request.auth.token.role == 'academy'
        && request.auth.token.academyId == academyId;
    }

    /** 직원 멤버 문서 — 컬렉션 이름이 바뀌면 이 경로만 고칠 것 */
    function staffMemberPath(academyId) {
      return academyTeacherMemberPath(academyId);
    }

    /** 활성 직원의 세부 권한 목록(역할에서 서버가 복사, `functions/src/roles.ts`) — 없으면 [] */
    function activeStaffPermissions(academyId) {
      let m = get(staffMemberPath(academyId)).data;
      return m.status == 'active'
          && m.keys().hasAny(['permissions'])
          && m.permissions is list
        ? m.permissions
        : [];
    }

    /**
     * 세부 권한(`functions/src/lib/permissions.ts`) 중 하나라도 있는지 — 원장·포털은 항상 참.
     * 직원 권한은 멤버 문서에서 바로 읽으므로 역할을 바꾸면 즉시 반영된다.
     */
    function hasAnyPermission(academyId, keys) {
      return isAcademyOwner(academyId)
        || isAcademyPortalSession(academyId)
        || (isSignedIn()
            && exists(staffMemberPath(academyId))
            && activeStaffPermissions(academyId).hasAny(keys));
    }

    function hasPermission(academyId, key) {
      return hasAnyPermission(academyId, [key]);
    }

    /** 학생의 부모로 지정된 학부모 문서가 존재하고 활성 상태인지 */
    function isActiveParentForStudent(academyId, parentUserId) {
      let p = /databases/$(database)/documents/academies/$(academyId)/parents/$(parentUserId);
      return exists(p) && get(p).data.status == 'active';
    }

    function teacherDocActive(academyId, tid) {
      return tid is string
        && exists(/databases/$(database)/documents/academies/$(academyId)/teachers/$(tid))
        && get(/databases/$(database)/documents/academies/$(academyId)/teachers/$(tid)).data.status == 'active';
    }

    /** 전담 요소 하나 — 기존 전담(prev)이면 유지 허용, 새로 추가되는 경우에만 활성 선생 문서 필요 */
    function assignedTeacherEntryOk(academyId, prev, tid) {
      return prev.hasAny([tid]) || teacherDocActive(academyId, tid);
    }

    /**
     * assignedTeacherUids — 최대 20명, 새로 추가되는 요소마다 활성 선생 문서 필요.
     * 비활성화된 선생은 재활성화 시 복구를 위해 전담이 유지되므로(`deactivateTeacher`) 기존 요소는 재검증하지 않음.
     * (규칙은 고정 길이 분기로 검증 — `MAX_ASSIGNED_TEACHERS_PER_STUDENT`와 맞출 것)
     */
    function assignedTeacherUidsListOk(academyId, u, prev) {
      return u is list
        && u.size() <= 20
        && (u.size() < 1 || assignedTeacherEntryOk(academyId, prev, u[0]))
        && (u.size() < 2 || assignedTeacherEntryOk(academyId, prev, u[1]))
        && (u.size() < 3 || assignedTeacherEntryOk(academyId, prev, u[2]))
        && (u.size() < 4 || assignedTeacherEntryOk(academyId, prev, u[3]))
        && (u.size() < 5 || assignedTeacherEntryOk(academyId, prev, u[4]))
        && (u.size() < 6 || assignedTeacherEntryOk(academyId, prev, u[5]))
        && (u.size() < 7 || assignedTeacherEntryOk(academyId, prev, u[6]))
        && (u.size() < 8 || assignedTeacherEntryOk(academyId, prev, u[7]))
        && (u.size() < 9 || assignedTeacherEntryOk(academyId, prev, u[8]))
        && (u.size() < 10 || assignedTeacherEntryOk(academyId, prev, u[9]))
        && (u.size() < 11 || assignedTeacherEntryOk(academyId, prev, u[10]))
        && (u.size() < 12 || assignedTeacherEntryOk(academyId, prev, u[11]))
        && (u.size() < 13 || assignedTeacherEntryOk(academyId, prev, u[12]))
        && (u.size() < 14 || assignedTeacherEntryOk(academyId, prev, u[13]))
        && (u.size() < 15 || assignedTeacherEntryOk(academyId, prev, u[14]))
        && (u.size() < 16 || assignedTeacherEntryOk(academyId, prev, u[15]))
        && (u.size() < 17 || assignedTeacherEntryOk(academyId, prev, u[16]))
        && (u.size() < 18 || assignedTeacherEntryOk(academyId, prev, u[17]))
        && (u.size() < 19 || assignedTeacherEntryOk(academyId, prev, u[18]))
        && (u.size() < 20 || assignedTeacherEntryOk(academyId, prev, u[19]));
    }

    /**
     * 수정 전 학생 문서의 전담 uid 목록(배열 + 구 단일 필드) — update에서만 사용(create에는 resource 없음).
     * 클라이언트가 저장 시 구 단일 필드를 배열로 병합하므로 둘 다 기존 전담으로 취급.
     */
    function prevAssignedTeacherUids() {
      let r = resource.data;
      let arr = r.keys().hasAny(['assignedTeacherUids']) && r.assignedTeacherUids is list
        ? r.assignedTeacherUids
        : [];
      let legacy = r.keys().hasAny(['assignedTeacherUid']) && r.assignedTeacherUid is string
        ? [r.assignedTeacherUid]
        : [];
      return arr.concat(legacy);
    }

    /**
     * 학생 전담 필드 — assignedTeacherUids(권장) 또는 구 assignedTeacherUid(마이그레이션 대비).
     * prev: 기존 전담 uid 목록(create는 []).
     */
    function studentAssignedTeacherOk(academyId, prev) {
      let d = request.resource.data;
      return (!d.keys().hasAny(['assignedTeacherUids'])
          || assignedTeacherUidsListOk(academyId, d.assignedTeacherUids, prev))
        && (!d.keys().hasAny(['assignedTeacherUid'])
            || d.assignedTeacherUid == null
            || (d.assignedTeacherUid is string
                && assignedTeacherEntryOk(academyId, prev, d.assignedTeacherUid)));
    }

    /**
     * 학부모 클라이언트가 학생 문서를 생성할 때 허용하는 필드 — 원비·회차·납부 상태 필드는
     * 결제 검증(`completePayment`)이 그대로 신뢰하므로 학부모가 지정할 수 없어야 함.
     */
    function parentStudentCreateFieldsOk() {
      return request.resource.data.keys().hasOnly([
        'parentUserId', 'name', 'age', 'phone', 'emergencyContact', 'createdAt', 'updatedAt'
      ]);
    }

    /**
     * 학부모 클라이언트의 학생 문서 수정 — 납부 안내 확인 표시(`payment-reminder-modal.tsx`)만 허용.
     * 그 외 필드(tuitionAmount·sessionBalance 등)는 학원(오너·포털)만 수정.
     */
    function parentStudentUpdateFieldsOk() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['tuitionReminderConfirmedAt', 'tuitionReminderConfirmedByUid'])
        && (!d.keys().hasAny(['tuitionReminderConfirmedAt'])
            || d.tuitionReminderConfirmedAt == request.time)
        && (!d.keys().hasAny(['tuitionReminderConfirmedByUid'])
            || d.tuitionReminderConfirmedByUid == request.auth.uid);
    }

    /**
     * 수납 권한(`billing.invoices`) 직원의 학생 문서 수정 — 원비·회차 필드만.
     * 이름·연락처·전담 등 원생 정보는 원생 관리 권한(`operations.students`)만 수정.
     */
    function studentBillingFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'tuitionType', 'tuitionDueDayOfMonth', 'tuitionAmount', 'sentTuitionReminders',
        'weeklySessionCount', 'pricePerSession', 'sessionBalance', 'extraSessionDates',
        'sentSessionPaymentReminder', 'tuitionReminderConfirmedAt', 'tuitionReminderConfirmedByUid',
        'absenceDeductionPerDay', 'updatedAt'
      ]);
    }

    /** 출결 권한(`lessons.attendance`) 직원 — 수업 완료 기록 시 잔여 회차 차감 필드만 */
    function studentSessionFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['sessionBalance', 'extraSessionDates', 'updatedAt']);
    }

    /**
     * 활성 선생님 클라이언트 — 학생 문서는 본인 전담(배열·구 단일 필드)에 한해 읽기만.
     * `in` 연산자는 list 쿼리 검증 시 에뮬레이터에서 evaluation error가 나는 경우가 있어 hasAny 사용.
     */
    function teacherCanReadAssignedStudent(student) {
      return student is map
        && ((student.keys().hasAny(['assignedTeacherUids'])
            && student.assignedTeacherUids is list
            && student.assignedTeacherUids.hasAny([request.auth.uid]))
          || (student.keys().hasAny(['assignedTeacherUid'])
              && student.assignedTeacherUid is string
              && student.assignedTeacherUid == request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /pushSubscriptions/{subId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      /** 대시보드 알림벨 — 생성은 Functions만, 본인 삭제만 허용 */
      match /dashboardBellItems/{itemId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      /**
       * 서버(Cloud Functions Admin SDK)만 쓰는 역할 활성 요약 — 클라이언트는 읽기만.
       * 2-2: 멤버십 변경 시 Functions가 갱신. 위조 방지를 위해 클라이언트 write는 항상 거부.
       * 문서 ID는 `activation` 단일 고정(`attn-schema.ts`와 동일).
       */
      match /serverMirror/{docId} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId && docId == "activation");
        allow create, update, delete: if false;
      }
    }

    match /academies/{academyId} {
      /**
       * 학원 문서 단건·목록(list) 모두에서 `resource`가 각 문서를 가리킵니다.
       * `get()`만으로 owner를 판별하면 collection query 검증이 실패할 수 있으므로
       * `resource.data.ownerUid` 비교를 포함합니다.
       */
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isAcademyPortalSession(academyId)
        || isAcademyOwner(academyId)
        || isAcademyTeacherMember(academyId)
        || isAcademyParentMember(academyId);

      /** 학원 생성 + 포털 비밀번호는 Cloud Functions(Admin SDK)에서만 처리 */
      allow create: if isAdmin();

      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      /** 오너가 설정한 학원 포털 비밀번호 등 — 클라이언트 직접 접근 불가(Admin SDK만) */
      match /secrets/{secretId} {
        allow read, write: if false;
      }

      /**
       * 직원(선생님) 멤버 문서 — 역할·권한(`roleId`, `permissions`)도 여기 있으므로 쓰기는 Functions만.
       * 원생 관리·반 관리는 담당 선생님 지정 때문에 목록을 읽는다.
       */
      match /teachers/{teacherId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'settings.staff', 'settings.members', 'operations.students', 'operations.classes'
          ])
          || (isSignedIn() && resource.data.authUid == request.auth.uid);

        allow create, update, delete: if false;
      }

      /** 역할(권한 묶음) — 생성·수정·배정은 Functions(`roles.ts`)만 */
      match /roles/{roleId} {
        allow read: if isAdmin() || hasPermission(academyId, 'settings.members');
        allow write: if false;
      }

      /** 원생 관리는 보호자 선택·표시 때문에 학부모 목록을 읽는다 */
      match /parents/{parentId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['operations.parents', 'operations.students'])
          || (isSignedIn() && resource.data.authUid == request.auth.uid);

        allow create, update, delete: if false;
      }

      /** 학원 대시보드 집계·알림 inbox — Functions(Admin SDK)만 쓰기 */
      match /meta/dashboardStats {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'operations.students', 'operations.parents', 'settings.members'
          ]);
        allow write: if false;
      }

      /** 가입 대기·초청 만료(멤버·학부모)와 회차 자동 충전(결제) 알림 */
      match /adminInbox/{inboxId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'settings.members', 'operations.parents', 'billing.payments'
          ]);
        allow write: if false;
      }

      /** 출석 키오스크 설정(해시·잠금) — Functions만 쓰기, 공개 필드만 읽기 */
      match /meta/kioskSettings {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['lessons.attendance', 'settings.general']);
        allow write: if false;
      }

      /**
       * 원비 납부 안내(카카오페이 링크·계좌) — 오너 쓰기, 수납 설정 권한은 납부 안내 필드만
       * (`owner-tuition-settings-card.tsx`). 포트원 channelKey는 결제 경로를 바꾸므로 오너만.
       * 소속 활성 학부모도 읽기 허용.
       */
      match /meta/tuitionSettings {
        function delegatedTuitionFields() {
          return ['kakaoPayLink', 'bankName', 'accountNumber', 'accountHolder', 'updatedAt'];
        }
        function canEditTuitionSettings() {
          return hasAnyPermission(academyId, ['billing.invoices', 'settings.general']);
        }
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'billing.invoices', 'billing.collections', 'settings.general'
          ])
          || isAcademyParentActive(academyId);
        allow create: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditTuitionSettings()
              && request.resource.data.keys().hasOnly(delegatedTuitionFields()));
        allow update: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditTuitionSettings()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(delegatedTuitionFields()));
        allow delete: if isAdmin()
          || isAcademyOwner(academyId);
      }

      /**
       * 원비 납부 방식 기본 설정 — 오너 쓰기, 수납·원생 관리 권한은 기본값 필드만
       * (`owner-session-tuition-settings-card.tsx`, 학생 패널 기본 납부 방식 모달).
       */
      match /meta/sessionTuitionSettings {
        function delegatedSessionTuitionFieldsOk(keys) {
          return keys.hasOnly([
              'defaultTuitionType', 'defaultTuitionDueDayOfMonth', 'defaultTuitionAmount',
              'defaultWeeklySessionCount', 'defaultPricePerSession', 'updatedAt'
            ])
            && (!request.resource.data.keys().hasAny(['defaultTuitionType'])
                || request.resource.data.defaultTuitionType in ['monthly_fixed', 'session_based']);
        }
        function canEditSessionTuitionSettings() {
          return hasAnyPermission(academyId, ['billing.invoices', 'operations.students']);
        }
        allow read: if isAdmin() || canEditSessionTuitionSettings();
        allow create: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditSessionTuitionSettings()
              && delegatedSessionTuitionFieldsOk(request.resource.data.keys()));
        allow update: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditSessionTuitionSettings()
              && delegatedSessionTuitionFieldsOk(
                request.resource.data.diff(resource.data).affectedKeys()));
        allow delete: if isAdmin()
          || isAcademyOwner(academyId);
      }

      /**
       * 결석 차감 제안 기본값 — 수납·전체설정 권한 쓰기(값 형식 검증), 학부모 비공개.
       * 차감은 원장이 청구 모달에서 확인 후 반영하므로 이 값 자체가 청구 금액을 바꾸지는 않음.
       */
      match /meta/absenceDeductionSettings {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['billing.invoices', 'settings.general']);
        allow write: if (isAdmin()
            || hasAnyPermission(academyId, ['billing.invoices', 'settings.general']))
          && request.resource.data.keys().hasOnly(['method', 'perDayAmount', 'monthlyClassDays', 'updatedAt'])
          && request.resource.data.method in ['per_day', 'divide']
          && (request.resource.data.method != 'per_day'
              || (request.resource.data.perDayAmount is int
                  && request.resource.data.perDayAmount > 0
                  && request.resource.data.perDayAmount <= 10000000))
          && (request.resource.data.method != 'divide'
              || (request.resource.data.monthlyClassDays is int
                  && request.resource.data.monthlyClassDays >= 1
                  && request.resource.data.monthlyClassDays <= 31));
      }

      match /students/{studentId} {
        /**
         * list 쿼리 검증 시 OR 전체가 분석되므로, parentUserId 등 필드가 없을 때 직접 접근하면
         * evaluation error가 날 수 있음 → 키 존재·타입 확인 후 비교.
         */
        /** 원생을 다루는 메뉴(원생·학부모·출결·수납)는 모두 학생 목록을 읽는다 */
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'operations.students', 'operations.parents', 'lessons.attendance',
            'billing.invoices', 'billing.collections', 'billing.payments'
          ])
          || (isAcademyTeacherActive(academyId) && teacherCanReadAssignedStudent(resource.data))
          || (isAcademyParentActive(academyId)
              && resource.data.keys().hasAny(['parentUserId'])
              && resource.data.parentUserId is string
              && resource.data.parentUserId == request.auth.uid);

        allow create: if
          (((isAdmin()
            || hasPermission(academyId, 'operations.students'))
          && request.resource.data.keys().hasAll(['parentUserId', 'name', 'createdAt'])
          && request.resource.data.parentUserId is string
          && request.resource.data.name is string
          && isActiveParentForStudent(academyId, request.resource.data.parentUserId))
          || (isAcademyParentActive(academyId)
              && request.resource.data.keys().hasAll(['parentUserId', 'name', 'createdAt'])
              && request.resource.data.parentUserId == request.auth.uid
              && parentStudentCreateFieldsOk()))
          && studentAssignedTeacherOk(academyId, []);

        /**
         * 학부모·수납·출결 분기는 전담 필드를 바꿀 수 없으므로 전담 검증을 생략 —
         * 전담 선생 중 비활성자가 있어도 원비·회차·납부 안내 확인 표시는 저장되도록.
         */
        allow update: if ((isAdmin()
          || hasPermission(academyId, 'operations.students'))
          && studentAssignedTeacherOk(academyId, prevAssignedTeacherUids()))
          || (hasPermission(academyId, 'billing.invoices') && studentBillingFieldsOnly())
          || (hasPermission(academyId, 'lessons.attendance') && studentSessionFieldsOnly())
          || (isAcademyParentActive(academyId)
              && resource.data.parentUserId == request.auth.uid
              && parentStudentUpdateFieldsOk());

        /** 학부모 측 삭제는 미수 회차 등 기록 소실 우려로 차단 — 삭제는 `deleteAcademyStudent`(학원 전용) */
        allow delete: if isAdmin()
          || hasPermission(academyId, 'operations.students');

        match /serverSecrets/{secretId} {
          allow read, write: if false;
        }

        /**
         * 출결 기록(문서 ID = 서울 기준 YYYY-MM-DD) — 결석 사유가 원비 차감 근거가 되므로
         * 쓰기는 Functions(`recordStudentAbsences` 등)만, 읽기는 학원만.
         */
        match /attendanceRecords/{date} {
          allow read: if isAdmin()
            || hasAnyPermission(academyId, ['lessons.attendance', 'billing.invoices']);
          allow write: if false;
        }

        /**
         * 월별 청구서(문서 ID = YYYY-MM) — 결제 검증이 신뢰하는 금액 근거이므로 쓰기는
         * Functions(조정·수동 납부)와 Next 서버(카드 결제)만. 학부모는 Callable 요약으로만 조회.
         */
        match /tuitionInvoices/{period} {
          allow read: if isAdmin()
            || hasAnyPermission(academyId, ['billing.invoices', 'billing.collections']);
          allow write: if false;
        }

        /** 수업 완료 기록 로그 — 출결 권한·활성 선생님이 생성, 삭제는 오너만 */
        match /sessionLogs/{logId} {
          allow read: if isAdmin()
            || hasAnyPermission(academyId, ['lessons.attendance', 'billing.invoices'])
            || isAcademyTeacherActive(academyId);
          allow create: if isAdmin()
            || hasPermission(academyId, 'lessons.attendance')
            || isAcademyTeacherActive(academyId);
          allow update, delete: if isAdmin()
            || isAcademyOwner(academyId);
        }
      }

      /**
       * 카드 결제(포트원 V2) 이력 — 검증·상태 갱신은 Cloud Functions(Admin SDK, onRequest)만 수행.
       * 클라이언트 쓰기는 isAdmin/isAcademyOwner 외에는 항상 거부(위변조 방지).
       */
      match /payments/{paymentId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['billing.payments', 'billing.collections'])
          || (isSignedIn()
              && resource.data.keys().hasAny(['parentUserId'])
              && resource.data.parentUserId is string
              && resource.data.parentUserId == request.auth.uid);

        allow create, update, delete: if isAdmin() || isAcademyOwner(academyId);
      }
    }

    /** attnId 로그인 조회 — Functions(Admin SDK)만 쓰기 */
    match /attnLoginIndex/{attnIdKey} {
      allow read, write: if false;
    }

    match /meta/attnGlobal {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
