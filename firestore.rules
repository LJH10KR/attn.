rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** 서비스 운영자 — Custom Claim `admin: true` (키 없을 때 `.admin` / `.get` 접근은 에뮬레이터에서 오류 날 수 있어 hasAny로 가드) */
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function academyData(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)).data;
    }

    function isAcademyOwner(academyId) {
      return isSignedIn() && academyData(academyId).ownerUid == request.auth.uid;
    }

    /** 직원 문서 경로(`staff`) — 계정이 있는 직원은 문서 ID = Auth uid(계정 없는 직원은 임의 ID) */
    function academyTeacherMemberPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId)/staff/$(request.auth.uid);
    }

    function isAcademyTeacherMember(academyId) {
      return isSignedIn() && exists(academyTeacherMemberPath(academyId));
    }

    /** 학원 업무(학생·학부모 등)에 참여 가능한 활성 선생님 */
    function isAcademyTeacherActive(academyId) {
      return isSignedIn()
        && exists(academyTeacherMemberPath(academyId))
        && get(academyTeacherMemberPath(academyId)).data.status == 'active';
    }

    /** 학부모 멤버 문서 — 초청 후 문서 ID = Auth uid (초청 전에는 임시 ID) */
    function academyParentMemberPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId)/parents/$(request.auth.uid);
    }

    function isAcademyParentMember(academyId) {
      return isSignedIn() && exists(academyParentMemberPath(academyId));
    }

    /** 자녀 연결 등 — 활성 학부모만 */
    function isAcademyParentActive(academyId) {
      return isSignedIn()
        && exists(academyParentMemberPath(academyId))
        && get(academyParentMemberPath(academyId)).data.status == 'active';
    }

    /**
     * 연결된 자녀·결제를 읽을 수 있는 학부모 계정 상태 — 실제 대상은 문서의 `parentUids`가 정한다.
     * 승인 대기(pending_approval)도 포함: 연결 직후 계정 상태 전환(트리거)이 몇 초 늦을 수 있어서.
     * 이메일 인증 전·첫 로그인 전·비활성 계정은 거부.
     */
    function isAcademyParentReader(academyId) {
      return isSignedIn()
        && exists(academyParentMemberPath(academyId))
        && get(academyParentMemberPath(academyId)).data.status in ['active', 'pending_approval'];
    }

    /** 문서의 uid 목록 필드(`parentUids`·`teacherUids`)에 본인이 있는지 — list 쿼리(array-contains)도 이 형태로 통과 */
    function uidListHasMe(list) {
      return list.hasAny([request.auth.uid]);
    }


    /** 권한 판별에 쓰는 본인 직원 문서 */
    function staffMemberPath(academyId) {
      return academyTeacherMemberPath(academyId);
    }

    /** 활성 직원의 세부 권한 목록(역할에서 서버가 복사, `functions/src/roles.ts`) — 없으면 [] */
    function activeStaffPermissions(academyId) {
      let m = get(staffMemberPath(academyId)).data;
      return m.status == 'active'
          && m.keys().hasAny(['permissions'])
          && m.permissions is list
        ? m.permissions
        : [];
    }

    /**
     * 세부 권한(`functions/src/lib/permissions.ts`) 중 하나라도 있는지 — 원장은 항상 참.
     * 직원 권한은 멤버 문서에서 바로 읽으므로 역할을 바꾸면 즉시 반영된다.
     */
    function hasAnyPermission(academyId, keys) {
      return isAcademyOwner(academyId)
        || (isSignedIn()
            && exists(staffMemberPath(academyId))
            && activeStaffPermissions(academyId).hasAny(keys));
    }

    function hasPermission(academyId, key) {
      return hasAnyPermission(academyId, [key]);
    }

    /**
     * 학부모 클라이언트의 학생 문서 수정 — 납부 안내 확인 표시(`payment-reminder-modal.tsx`)만 허용.
     * 그 외 필드(tuitionAmount·sessionBalance 등)는 학원(원장·권한 직원)만 수정.
     */
    function parentStudentUpdateFieldsOk() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['tuitionReminderConfirmedAt', 'tuitionReminderConfirmedByUid'])
        && (!d.keys().hasAny(['tuitionReminderConfirmedAt'])
            || d.tuitionReminderConfirmedAt == request.time)
        && (!d.keys().hasAny(['tuitionReminderConfirmedByUid'])
            || d.tuitionReminderConfirmedByUid == request.auth.uid);
    }

    /**
     * 원생 관리·수납 권한 직원의 학생 문서 수정 — 원비·회차 필드만(원생 정보는 `saveStudent` 서버 함수만).
     * TODO(4단계 청구서): 원비·회차 값 자체는 검증하지 않음(sessionBalance 등 임의 값 가능) —
     * 청구서·회차제 통합으로 이 필드들이 서버 전용이 되면 이 분기를 제거할 것.
     */
    function studentBillingFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'tuitionType', 'tuitionDueDayOfMonth', 'tuitionAmount', 'sentTuitionReminders',
        'weeklySessionCount', 'pricePerSession', 'sessionBalance', 'extraSessionDates',
        'sentSessionPaymentReminder', 'tuitionReminderConfirmedAt', 'tuitionReminderConfirmedByUid',
        'absenceDeductionPerDay', 'updatedAt'
      ]);
    }

    /**
     * 원생 관리·출결·수납 권한 직원 — 수업 완료 기록 시 잔여 회차 차감 필드만.
     * TODO(3단계 출결): sessionBalance를 아무 값으로나 바꿀 수 있음(1회 차감인지 검증 안 함) —
     * 출석·지각 처리 시 서버가 자동 차감하는 구조로 바뀌면 이 분기를 제거할 것.
     */
    function studentSessionFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['sessionBalance', 'extraSessionDates', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /pushSubscriptions/{subId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      /** 대시보드 알림벨 — 생성은 Functions만, 본인 삭제만 허용 */
      match /dashboardBellItems/{itemId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      /**
       * 서버(Cloud Functions Admin SDK)만 쓰는 역할 활성 요약 — 클라이언트는 읽기만.
       * 2-2: 멤버십 변경 시 Functions가 갱신. 위조 방지를 위해 클라이언트 write는 항상 거부.
       * 문서 ID는 `activation` 단일 고정(`attn-schema.ts`와 동일).
       */
      match /serverMirror/{docId} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId && docId == "activation");
        allow create, update, delete: if false;
      }
    }

    match /academies/{academyId} {
      /**
       * 학원 문서 단건·목록(list) 모두에서 `resource`가 각 문서를 가리킵니다.
       * `get()`만으로 owner를 판별하면 collection query 검증이 실패할 수 있으므로
       * `resource.data.ownerUid` 비교를 포함합니다.
       */
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isAcademyOwner(academyId)
        || isAcademyTeacherMember(academyId)
        || isAcademyParentMember(academyId);

      /** 학원 생성은 Cloud Functions(Admin SDK)에서만 처리 */
      allow create: if isAdmin();

      /**
       * 2-N B1 — 원장 화면(학원 수정)이 쓰는 필드만(이름·운영 상태·수정 시각). ownerUid·attnId 등 나머지는 서버만.
       * 삭제는 서버 함수만(`deleteOwnerAcademy`·`adminDeleteAcademyCascade` — 하위 데이터·계정까지 정리).
       */
      allow update: if (isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.status in ['active', 'archived'];
      allow delete: if false;

      /** 서버 전용 비밀 값(예전 포털 비밀번호 등) — 클라이언트 직접 접근 불가(Admin SDK만) */
      match /secrets/{secretId} {
        allow read, write: if false;
      }

      /**
       * 직원 — 인사 정보 + 선택적 계정(`authUid`, `status`)과 역할·권한(`roleId`, `permissions`)이 한 문서.
       * 권한이 들어 있으므로 쓰기는 Functions(`staff.ts`, `teachers.ts`, `roles.ts`)만.
       * 원생 관리·반 관리는 담당 선생님 지정 때문에 목록을 읽는다.
       */
      match /staff/{staffId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'settings.staff', 'settings.members', 'operations.students', 'operations.classes'
          ])
          || (isSignedIn() && resource.data.authUid == request.auth.uid);

        allow create, update, delete: if false;
      }

      /** 역할(권한 묶음) — 생성·수정·배정은 Functions(`roles.ts`)만 */
      match /roles/{roleId} {
        allow read: if isAdmin() || hasPermission(academyId, 'settings.members');
        allow write: if false;
      }

      /** 원생 관리는 보호자 선택·표시 때문에 학부모 목록을 읽는다 */
      match /parents/{parentId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['operations.parents', 'operations.students'])
          || (isSignedIn() && resource.data.authUid == request.auth.uid);

        allow create, update, delete: if false;
      }

      /** 학원 대시보드 집계·알림 inbox — Functions(Admin SDK)만 쓰기 */
      match /meta/dashboardStats {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'operations.students', 'operations.parents', 'settings.members'
          ]);
        allow write: if false;
      }

      /** 가입 대기·초청 만료(멤버·학부모)와 회차 자동 충전(결제) 알림 */
      match /adminInbox/{inboxId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'settings.members', 'operations.parents', 'billing.payments'
          ]);
        allow write: if false;
      }

      /**
       * 학원 선택지 목록(직무 등, `{id, label}` 배열) — 민감 정보가 없어 원장·활성 직원 읽기,
       * 쓰기는 Functions(`saveAcademyOptionList`, 목록 종류별 권한 검사)만.
       */
      match /meta/options {
        allow read: if isAdmin()
          || isAcademyOwner(academyId)
          || isAcademyTeacherActive(academyId);
        allow write: if false;
      }

      /** 출석 키오스크 설정(해시·잠금) — Functions만 쓰기, 공개 필드만 읽기 */
      match /meta/kioskSettings {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['lessons.attendance', 'settings.general']);
        allow write: if false;
      }

      /**
       * 원비 납부 안내(카카오페이 링크·계좌) — 오너 쓰기, 수납 설정 권한은 납부 안내 필드만
       * (`owner-tuition-settings-card.tsx`). 포트원 channelKey는 결제 경로를 바꾸므로 오너만.
       * 소속 활성 학부모도 읽기 허용.
       */
      match /meta/tuitionSettings {
        function delegatedTuitionFields() {
          return ['kakaoPayLink', 'bankName', 'accountNumber', 'accountHolder', 'updatedAt'];
        }
        function canEditTuitionSettings() {
          return hasAnyPermission(academyId, ['billing.invoices', 'settings.general']);
        }
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'billing.invoices', 'billing.collections', 'settings.general'
          ])
          || isAcademyParentActive(academyId);
        allow create: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditTuitionSettings()
              && request.resource.data.keys().hasOnly(delegatedTuitionFields()));
        allow update: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditTuitionSettings()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(delegatedTuitionFields()));
        allow delete: if isAdmin()
          || isAcademyOwner(academyId);
      }

      /**
       * 원비 납부 방식 기본 설정 — 오너 쓰기, 수납·원생 관리 권한은 기본값 필드만
       * (`owner-session-tuition-settings-card.tsx`, 학생 패널 기본 납부 방식 모달).
       */
      match /meta/sessionTuitionSettings {
        function delegatedSessionTuitionFieldsOk(keys) {
          return keys.hasOnly([
              'defaultTuitionType', 'defaultTuitionDueDayOfMonth', 'defaultTuitionAmount',
              'defaultWeeklySessionCount', 'defaultPricePerSession', 'updatedAt'
            ])
            && (!request.resource.data.keys().hasAny(['defaultTuitionType'])
                || request.resource.data.defaultTuitionType in ['monthly_fixed', 'session_based']);
        }
        function canEditSessionTuitionSettings() {
          return hasAnyPermission(academyId, ['billing.invoices', 'operations.students']);
        }
        allow read: if isAdmin() || canEditSessionTuitionSettings();
        allow create: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditSessionTuitionSettings()
              && delegatedSessionTuitionFieldsOk(request.resource.data.keys()));
        allow update: if isAdmin()
          || isAcademyOwner(academyId)
          || (canEditSessionTuitionSettings()
              && delegatedSessionTuitionFieldsOk(
                request.resource.data.diff(resource.data).affectedKeys()));
        allow delete: if isAdmin()
          || isAcademyOwner(academyId);
      }

      /**
       * 결석 차감 제안 기본값 — 수납·전체설정 권한 쓰기(값 형식 검증), 학부모 비공개.
       * 차감은 원장이 청구 모달에서 확인 후 반영하므로 이 값 자체가 청구 금액을 바꾸지는 않음.
       */
      match /meta/absenceDeductionSettings {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['billing.invoices', 'settings.general']);
        allow write: if (isAdmin()
            || hasAnyPermission(academyId, ['billing.invoices', 'settings.general']))
          && request.resource.data.keys().hasOnly(['method', 'perDayAmount', 'monthlyClassDays', 'updatedAt'])
          && request.resource.data.method in ['per_day', 'divide']
          && (request.resource.data.method != 'per_day'
              || (request.resource.data.perDayAmount is int
                  && request.resource.data.perDayAmount > 0
                  && request.resource.data.perDayAmount <= 10000000))
          && (request.resource.data.method != 'divide'
              || (request.resource.data.monthlyClassDays is int
                  && request.resource.data.monthlyClassDays >= 1
                  && request.resource.data.monthlyClassDays <= 31));
      }

      /**
       * 원생 내부 메모 — 학부모가 읽는 학생 문서와 분리(원생 관리 권한만 읽기), 쓰기는 `saveStudent`만.
       */
      match /studentNotes/{studentId} {
        allow read: if isAdmin() || hasPermission(academyId, 'operations.students');
        allow write: if false;
      }

      /**
       * 반 — 민감 정보가 없어 원장·활성 직원 읽기(선생님 "내 반" 조회), 쓰기는 Functions(`classes.ts`)만.
       */
      match /classes/{classId} {
        allow read: if isAdmin()
          || isAcademyOwner(academyId)
          || isAcademyTeacherActive(academyId);
        allow write: if false;
      }

      /** 반 변경 이력 — 저장만(서버 전용) */
      match /classHistory/{entryId} {
        allow read, write: if false;
      }

      /**
       * 반 출결(문서 ID = `{date}_{classId}_{studentId}`, 2-I) — 쓰기는 Functions(`recordClassAttendance`)만.
       * 읽기는 출결·청구서 권한, 그리고 그 반 선생님(반 `teacherUids`) — 선생님은 `classId ==` 조건 목록 조회로 읽는다.
       */
      match /attendance/{attendanceId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, ['lessons.attendance', 'billing.invoices'])
          || (isAcademyTeacherActive(academyId)
              && uidListHasMe(get(/databases/$(database)/documents/academies/$(academyId)/classes/$(resource.data.classId)).data.teacherUids));
        allow write: if false;
      }

      match /students/{studentId} {
        /**
         * 원생을 다루는 메뉴(원생·학부모·반·출결·수납)는 모두 학생 목록을 읽는다.
         * 활성 선생님은 담당 반 학생(`teacherUids`, 반에서 서버 계산)만 — list는 `teacherUids array-contains` 쿼리.
         * 학부모는 연결된 자녀(`parentUids`, 서버 계산)만 — 계정 상태도 함께 본다.
         */
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'operations.students', 'operations.parents', 'operations.classes', 'lessons.attendance',
            'billing.invoices', 'billing.collections', 'billing.payments'
          ])
          || (isAcademyTeacherActive(academyId) && uidListHasMe(resource.data.teacherUids))
          || (isAcademyParentReader(academyId) && uidListHasMe(resource.data.parentUids));

        /** 생성·원생 정보 수정은 서버(`saveStudent`)만 — 파생 필드(parentUids 등)를 클라이언트가 못 바꾸게 */
        allow create: if false;

        /** 원비·회차 필드(4단계까지 기존 화면)와 학부모 납부 안내 확인 표시만 클라이언트 수정 */
        allow update: if (hasAnyPermission(academyId, ['operations.students', 'billing.invoices'])
            && studentBillingFieldsOnly())
          || (hasAnyPermission(academyId, ['operations.students', 'lessons.attendance', 'billing.invoices'])
            && studentSessionFieldsOnly())
          || (isAcademyParentActive(academyId)
              && uidListHasMe(resource.data.parentUids)
              && parentStudentUpdateFieldsOk());

        /** 삭제는 하위 기록·메모까지 지우는 `deleteAcademyStudent`(서버)만 */
        allow delete: if false;

        match /serverSecrets/{secretId} {
          allow read, write: if false;
        }

        /**
         * 등원 기록(문서 ID = 서울 기준 YYYY-MM-DD, present=등원·absent=미등원) — 미등원 사유가 원비 차감
         * 근거가 되므로 쓰기는 Functions(`recordStudentArrival`·`recordStudentAbsences` 등)만.
         * 읽기는 출결·청구서 권한, 그리고 담당 선생님(학생 `teacherUids`, 2-I ★6 — "등원 처리"·출석 버튼 판단).
         */
        match /attendanceRecords/{date} {
          allow read: if isAdmin()
            || hasAnyPermission(academyId, ['lessons.attendance', 'billing.invoices'])
            || (isAcademyTeacherActive(academyId)
                && uidListHasMe(get(/databases/$(database)/documents/academies/$(academyId)/students/$(studentId)).data.teacherUids));
          allow write: if false;
        }

        /**
         * 월별 청구서(문서 ID = YYYY-MM) — 결제 검증이 신뢰하는 금액 근거이므로 쓰기는
         * Functions(조정·수동 납부)와 Next 서버(카드 결제)만. 학부모는 Callable 요약으로만 조회.
         */
        match /tuitionInvoices/{period} {
          allow read: if isAdmin()
            || hasAnyPermission(academyId, ['billing.invoices', 'billing.collections']);
          allow write: if false;
        }

        /** 수업 완료 기록 로그 — 출결 권한·활성 선생님이 생성, 삭제는 오너만 */
        match /sessionLogs/{logId} {
          allow read: if isAdmin()
            || hasAnyPermission(academyId, ['lessons.attendance', 'billing.invoices'])
            || isAcademyTeacherActive(academyId);
          allow create: if isAdmin()
            || hasPermission(academyId, 'lessons.attendance')
            || isAcademyTeacherActive(academyId);
          allow update, delete: if isAdmin()
            || isAcademyOwner(academyId);
        }
      }

      /**
       * 카드 결제(포트원 V2) 이력 — 검증·상태 갱신은 Cloud Functions(Admin SDK, onRequest)만 수행.
       * 클라이언트 쓰기는 isAdmin/isAcademyOwner 외에는 항상 거부(위변조 방지).
       */
      /**
       * 결제 취소(환불)는 Next 서버(`/api/payment/cancel`)가 `billing.refunds`로 검사하고 Admin SDK로 갱신 —
       * 환불 권한만 받은 직원도 취소할 결제를 찾을 수 있게 읽기를 허용.
       */
      match /payments/{paymentId} {
        allow read: if isAdmin()
          || hasAnyPermission(academyId, [
            'billing.payments', 'billing.collections', 'billing.refunds'
          ])
          || (isAcademyParentReader(academyId) && uidListHasMe(resource.data.parentUids));

        allow create, update, delete: if isAdmin() || isAcademyOwner(academyId);
      }
    }

    /** attnId 로그인 조회 — Functions(Admin SDK)만 쓰기 */
    match /attnLoginIndex/{attnIdKey} {
      allow read, write: if false;
    }

    match /meta/attnGlobal {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
