# Firebase 웹 앱 (콘솔 > 프로젝트 설정 > 일반 > 내 앱)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 로컬 에뮬레이터 연결 시 1
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1

# HTTP Functions(onRequest) axios base URL — 비우면 에뮬+projectId일 때 자동:
# http://127.0.0.1:5001/{NEXT_PUBLIC_FIREBASE_PROJECT_ID}/asia-northeast3
# NEXT_PUBLIC_API_BASE_URL=

# 이메일 액션(비밀번호 재설정·인증) 이후 리다이렉트 등 — 배포 시 실제 도메인
# NEXT_PUBLIC_APP_ORIGIN=https://your-domain.example

# Cloud Functions (선생님 초청 메일) — 비우면 에뮬에서는 링크가 Functions 로그에만 출력
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# APP_ORIGIN=https://your-domain.example

# App Check (선택) — Callable 남용·봇 호출 완화. 콘솔에서 App Check 등록 후 사이트 키 입력.
# NEXT_PUBLIC_APPCHECK_SITE_KEY=
# 에뮬레이터: 콘솔에 찍힌 디버그 토큰을 Firebase 콘솔에 등록하거나 아래에 고정 토큰 사용.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Functions에서 App Check 미통과 요청 거부(클라이언트에 위 키·콘솔 설정 필수)
# ENFORCE_APP_CHECK=1
